# Copy these into Vercel: Project Settings -> Environment Variables.
# Never commit real values to the repository.

# Resend API key (Resend dashboard -> API Keys). Needs "Full access" so it can add contacts.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The Resend Audience (called a "Segment" in newer Resend dashboards) that stores newsletter signups.
# Copy the ID from Resend -> Audiences (or Contacts -> Segments). Set ONE of these two.
RESEND_AUDIENCE_ID=
RESEND_SEGMENT_ID=

# Contact form. The FROM address must be on a domain verified in Resend.
CONTACT_FROM_EMAIL=Fifty and Unfiltered <hello@fiftyandunfiltered.com>
CONTACT_TO_EMAIL=mgeter@fiftyandunfiltered.com
